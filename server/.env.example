# 当前运行环境：dev / test / prod，决定加载哪个 .env.{APP_ENV} 文件
APP_ENV="dev"
# Node.js 运行模式：development / test / production，由 APP_ENV 自动映射
NODE_ENV="development"
# PostgreSQL 数据库连接字符串（Prisma 通过 prisma.config.ts 读取此变量）
DATABASE_URL="postgresql://username:password@localhost:5432/mydb?schema=public"
# JWT 签名密钥（Access Token 使用，长度须 ≥ 32 字符）
JWT_SECRET="your-jwt-secret-at-least-32-characters-long"
# HTTP 服务监听端口（默认 8051，部署标准 §2.3 宿主 127.0.0.1:8051）
PORT="8051"
# CORS 放行来源（逗号分隔；client HTTP 直连默认 app://——02 §3.4 注）
CORS_ORIGINS="app://"
# 对象存储驱动（TDD-S-05）：disk＝生产默认（03 §7.3#1）；s3＝升级位（T2-13 起可用）
STORAGE_DRIVER="disk"
# disk 驱动对象目录（server 工作目录下 storage/）
STORAGE_DIR="storage"
# —— S3 兼容驱动（STORAGE_DRIVER=s3 时必填：S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY）——
# 自定义 endpoint（MinIO/COS/R2 等 S3 兼容面；AWS 原生留空）。MinIO 记法：endpoint＋路径风格（默认 true）
#S3_ENDPOINT="http://127.0.0.1:9000"
#S3_BUCKET="constella"
#S3_REGION="us-east-1"
#S3_ACCESS_KEY_ID="minioadmin"
#S3_SECRET_ACCESS_KEY="minioadmin"
#S3_FORCE_PATH_STYLE="true"
# —— 首个 ADMIN 引导（TDD-S-04 §1 ⚠ b：AdminSeed 启动幂等首建；未设则跳过）——
#ADMIN_EMAIL="admin@example.com"
#ADMIN_PASSWORD="change-me-at-least-8"
