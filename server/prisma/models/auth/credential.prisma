// 用户认证凭证模型
// C3（T2-02，TDD-S-01 §4）：补 role(USER|ADMIN)/isAuthor/status(ACTIVE|BANNED)——DDL 以 02 §7.2 为准
// 枚举落 auth 模型文件（多文件 schema，02 §5.3）

// 用户角色：USER 普通；ADMIN 管理端（admin 域 S-04 消费）；作者=USER 首次发布置 isAuthor（D-1 两态）
enum Role {
  USER
  ADMIN
}

// 用户状态：ACTIVE 正常；BANNED 封禁（禁登录/禁刷新/资料 401，即时生效）
enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id            String     @id @default(uuid())  // 主键，UUID 自动生成
  email         String     @unique               // 邮箱，唯一约束
  passwordHash  String                           // bcrypt 哈希后的密码
  role          Role       @default(USER)        // C3：默认 USER（增量迁移新列带默认值 expand）
  isAuthor      Boolean    @default(false)       // C3：首次发布置 true（D-1 ⚠ 两态）
  status        UserStatus @default(ACTIVE)      // C3：默认 ACTIVE
  createdAt     DateTime   @default(now())        // 记录创建时间
  updatedAt     DateTime   @updatedAt             // 自动更新时间
  refreshTokens RefreshToken[]                   // 一对多关联：该用户的所有 Refresh Token
  // 02 §7.2 User 反向关系（T2-05/T2-08 增补：market/review 域数据层共享——prisma models 位于域层之下）
  packages      Package[]                         // 该用户发布的包（owner 一对多）
  reviews       ReviewRecord[]                   // 该用户作出的审核决策（reviewer 一对多）
}
