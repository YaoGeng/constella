# /opt/aim/constella/.env 模板 —— S-01 生产环境变量（T6-14；部署标准 §6.4）
# 用法：复制到服务器产品目录后逐项填真实值：cp env.example /opt/aim/constella/.env && chmod 600
# 红线（§6.4/§10 R2）：凭据不进 git、不写入日志、不经聊天工具传输；
#   真实值仅存本文件（600）＋密码管理器，并汇总至 /opt/aim/infra/CREDENTIALS.md（600）。
# 全部为占位符——本文件不含任何真实凭据。

# —— 镜像版本（compose 插值用；禁 latest——§6.1。与发布 tag / server/package.json version 一致）——
CONSTELLA_VERSION="0.1.0"

# —— 必填（compose environment 块 ${VAR:?} 强制，漏写即拒起）——
# 数据库连接串（契约#6）：主机名=容器名 aim-pg:5432，constella 专属账号（步 5 §7.1 SOP 创建；R3 禁超级用户）
DATABASE_URL="postgresql://constella_app:<DB_PASSWORD>@aim-pg:5432/constella?schema=public"
# JWT 签名密钥（≥32 字符；openssl rand -base64 48 生成）
JWT_SECRET="<JWT_SECRET_AT_LEAST_32_CHARS>"
# 首个 ADMIN 引导（T2-11 AdminSeed——应用启动钩子幂等首建，同 email 重启跳过；生产强制提供）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<ADMIN_PASSWORD_AT_LEAST_8>"

# —— 可选（缺省即下列默认，与 server/src/utils/env.ts 缺省一致；compose environment 块回落同值）——
# CORS 放行来源（admin 同域经反代免 CORS=A-01 生产口径；如需显式放行子域则填 https://constella.aim8848.com）
#CORS_ORIGINS="app://"
# 对象存储驱动（disk=生产默认；s3=升级位 T2-13——启用时另需 S3_* 五项，见 server/.env.example）
#STORAGE_DRIVER="disk"
#STORAGE_DIR="storage"
