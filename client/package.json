{
  "name": "@constella/client",
  "private": true,
  "version": "0.0.0",
  "description": "Constella 桌面客户端（Electron main / preload / renderer 三目录，T0-08 / TDD-C-M1）",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.mjs && vite build && electron .",
    "build": "node esbuild.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "notices": "node scripts/gen-notices.mjs",
    "install:electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "playwright-core": "1.65.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@constella/shared": "workspace:*",
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.1",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zundo": "2.3.0",
    "zustand": "5.1.0"
  }
}
